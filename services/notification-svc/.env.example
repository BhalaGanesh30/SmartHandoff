# notification-service environment variables
# Copy this file to .env and fill in the actual values

# Database
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/smarthandoff

# Google Cloud Platform
GCP_PROJECT_ID=your-gcp-project-id
PUBSUB_SUBSCRIPTION_ID=notification-service-sub

# SendGrid Configuration (TASK-004)
SENDGRID_FROM_EMAIL=noreply@yourdomain.com

# Twilio Configuration (TASK-003)
TWILIO_FROM_NUMBER=+15551234567

# Service Configuration
PORT=8080

# Secret Manager Secret Names (do not change unless you modify the secret names in GCP)
# These are referenced by app/core/secrets.py:
#   - twilio-account-sid
#   - twilio-auth-token
#   - sendgrid-api-key
